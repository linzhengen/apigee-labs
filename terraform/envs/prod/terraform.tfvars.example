project_id        = "my-gcp-project"
region            = "asia-northeast1"
domain            = "app.example.com"
# IAP OAuth クライアント (GCP Console → APIs & Services → Credentials で作成)
iap_oauth_client_id     = "xxxx.apps.googleusercontent.com"
iap_oauth_client_secret = "GOCSPX-xxxx"

iap_allowed_members = [
  "user:alice@example.com",
  "group:engineers@example.com",
]

frontend_image = "asia-northeast1-docker.pkg.dev/my-gcp-project/repo/frontend:latest"
backend_image  = "asia-northeast1-docker.pkg.dev/my-gcp-project/repo/backend:latest"

github_repo = "owner/repo-name"
