project_id        = "my-gcp-project"
# 大阪追加時: regions = ["asia-northeast1", "asia-northeast2"]
#   ※ main.tf の locals.region_networks に asia-northeast2 の CIDR を追記すること
regions           = ["asia-northeast1"]
domain            = "app.example.com"

iap_allowed_members = [
  "user:alice@example.com",
  "group:engineers@example.com",
]

# 初回は未指定 (default: gcr.io/cloudrun/hello)。CI/CD で実イメージに更新される。
# frontend_image = "asia-northeast1-docker.pkg.dev/my-gcp-project/docker/frontend-service:latest"
# backend_image  = "asia-northeast1-docker.pkg.dev/my-gcp-project/docker/backend-service:latest"

github_repo = "owner/repo-name"

# 利用ログ (Apigee → Pub/Sub → Cloud Run Functions → BigQuery)
# プロンプト・生成文を BigQuery に保存したくない場合は false にする。
# usage_log_include_payloads  = true
# usage_log_max_payload_chars = 8000
