<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <HTTPProxyConnection>
    <BasePath>/api/vertexai</BasePath>
  </HTTPProxyConnection>

  <PreFlow name="PreFlow">
    <Request>
      <!-- IAP JWT からユーザーのメールアドレスを抽出 -->
      <Step><Name>DJ-DecodeIapJwt</Name></Step>

      <!-- 短時間の連続リクエストを防止 -->
      <Step><Name>SA-SpikeArrest</Name></Step>

      <!-- ユーザーごとのリクエスト数クォータ -->
      <Step><Name>QU-PerUserQuota</Name></Step>

      <!-- クライアントの Authorization ヘッダーと API キーを除去 -->
      <Step><Name>AM-RemoveClientAuth</Name></Step>

      <!-- パスからモデル・リージョンを抽出 -->
      <Step><Name>EV-ExtractModelPath</Name></Step>

      <!-- モデルパスが取得できなかった場合は 404 を返す -->
      <Step>
        <Name>RF-ModelNotFound</Name>
        <Condition>modelAction = null OR modelAction = ""</Condition>
      </Step>

      <!-- targetRegion → resolvedRegion (未設定時は "global") -->
      <Step><Name>AM-ResolveRegion</Name></Step>

      <!-- リージョン指定時はターゲットホストをリージョナルエンドポイントに切替 -->
      <Step>
        <Name>AM-SetRegionalHost</Name>
        <Condition>targetRegion != null AND targetRegion != ""</Condition>
      </Step>

      <!-- target.url の設定は TargetEndpoint PreFlow の JS-SetTargetUrl で実行 -->
    </Request>
    <Response>
      <!-- クォータ残量をレスポンスヘッダーに付与 -->
      <Step><Name>AM-AddQuotaHeaders</Name></Step>
    </Response>
  </PreFlow>

  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
