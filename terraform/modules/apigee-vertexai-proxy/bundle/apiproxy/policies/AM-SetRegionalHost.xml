<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  リージョン指定時に resolvedHost をリージョナルエンドポイントに更新。
  例: targetRegion = "asia-northeast1"
    → resolvedHost = "asia-northeast1-aiplatform.googleapis.com"
-->
<AssignMessage name="AM-SetRegionalHost">
  <AssignTo createNew="false" type="request"/>
  <AssignVariable>
    <Name>resolvedHost</Name>
    <Template>{targetRegion}-aiplatform.googleapis.com</Template>
  </AssignVariable>
</AssignMessage>
