<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  JSONPath 抽出結果から配列括弧・引用符を除去して数値文字列にする。
  例: ["255"] → 255
-->
<AssignMessage name="AM-CleanTokenCounts" continueOnError="false" enabled="true">
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignVariable>
    <Name>bracketsRegex</Name>
    <Value>\[\"{0,1}|\"{0,1}\]</Value>
  </AssignVariable>
  <AssignVariable>
    <Name>promptTokenCount</Name>
    <Template>{replaceAll(promptTokenCountRaw,bracketsRegex,'')}</Template>
  </AssignVariable>
  <AssignVariable>
    <Name>candidatesTokenCount</Name>
    <Template>{replaceAll(candidatesTokenCountRaw,bracketsRegex,'')}</Template>
  </AssignVariable>
  <AssignVariable>
    <Name>totalTokenCount</Name>
    <Template>{replaceAll(totalTokenCountRaw,bracketsRegex,'')}</Template>
  </AssignVariable>
</AssignMessage>
