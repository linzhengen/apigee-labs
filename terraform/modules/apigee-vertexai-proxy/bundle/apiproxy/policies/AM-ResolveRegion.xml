<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  targetRegion が未設定 (グローバルパターン) の場合:
    resolvedRegion = "global", resolvedHost = "aiplatform.googleapis.com"
  targetRegion が設定されている場合:
    resolvedRegion = targetRegion, resolvedHost = "{region}-aiplatform.googleapis.com"
-->
<AssignMessage name="AM-ResolveRegion">
  <AssignTo createNew="false" type="request"/>
  <AssignVariable>
    <Name>resolvedRegion</Name>
    <Value>global</Value>
    <Ref>targetRegion</Ref>
  </AssignVariable>
  <AssignVariable>
    <Name>resolvedHost</Name>
    <Value>aiplatform.googleapis.com</Value>
  </AssignVariable>
</AssignMessage>
